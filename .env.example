# ─── Upstash Redis (via Vercel Marketplace) ────────────────────────────────
# Either pair works — Redis.fromEnv() picks up whichever is present.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── n8n narrative webhook (Phase B / C2) ──────────────────────────────────
# URL for the n8n Cloud workflow that proxies to Anthropic for the
# personalized 2–3 sentence narrative paragraph.
N8N_NARRATIVE_WEBHOOK=

# ─── Kit (newsletter, Phase C3) ────────────────────────────────────────────
# v3 API. The form ID controls which Kit form/tag the subscriber lands in.
# The subscriber is tagged/segmented `transfer-blueprint`.
KIT_API_KEY=
KIT_FORM_ID=
